{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_metadata": {
    "title": "Metadata Schema Encoding Rules JSON Schema",
    "description": "JSON Schema for validating metadata-schema encoding-rules sidecar structures",
    "author": "Steven Paradise",
    "filename": "metadata-schema.encoding-rules.schema.json",
    "schema_version": "2.0.0",
    "version": "2.0.0",
    "date": "2026-05-01",
    "lastmod": "2026-05-02"
  },
  "title": "Encoding Rules Sidecar Schema",
  "description": "Schema for validating machine-readable encoding policy sidecars",
  "type": "object",
  "required": [
    "title",
    "description",
    "author",
    "filename",
    "schema_version",
    "version",
    "date",
    "lastmod",
    "encoding_policy",
    "enforcement"
  ],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "filename": { "type": "string" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastmod": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "encoding_policy": {
      "type": "object",
      "required": ["defaults", "groups", "coverage"],
      "properties": {
        "defaults": {
          "type": "object",
          "required": ["text_encoding", "bom"],
          "properties": {
            "text_encoding": { "type": "string" },
            "bom": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["text_encoding", "bom", "rationale"],
            "properties": {
              "extensions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "basenames": {
                "type": "array",
                "items": { "type": "string" }
              },
              "text_encoding": { "type": "string" },
              "bom": { "type": "boolean" },
              "rationale": { "type": "string" }
            },
            "anyOf": [
              { "required": ["extensions"] },
              { "required": ["basenames"] }
            ],
            "additionalProperties": true
          }
        },
        "coverage": {
          "type": "object",
          "required": ["inventory_ref", "covered_extensions", "covered_basenames"],
          "properties": {
            "inventory_ref": { "type": "string" },
            "covered_extensions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "covered_basenames": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "enforcement": {
      "type": "object",
      "required": ["editorconfig", "vscode_settings", "scanner_script"],
      "properties": {
        "editorconfig": { "type": "string" },
        "vscode_settings": { "type": "string" },
        "scanner_script": { "type": "string" }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

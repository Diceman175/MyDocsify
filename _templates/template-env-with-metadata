# ============================================================
# Application Configuration
# ============================================================

# Application name and version
REACT_APP_NAME=Your Application Name
REACT_APP_VERSION=0.1.0
REACT_APP_ENVIRONMENT=development

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=30000

# ============================================================
# Feature Flags
# ============================================================

REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_BETA_FEATURES=false

# ============================================================
# Authentication & Security
# ============================================================

# API Keys (keep these secret!)
REACT_APP_API_KEY=your_api_key_here
REACT_APP_SECRET_KEY=your_secret_key_here

# OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_AUTH0_DOMAIN=your_auth0_domain_here
REACT_APP_AUTH0_CLIENT_ID=your_auth0_client_id_here

# ============================================================
# External Services
# ============================================================

# Email Service
REACT_APP_SENDGRID_API_KEY=your_sendgrid_key_here
REACT_APP_NOTIFICATION_EMAIL=notifications@example.com

# Analytics & Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
REACT_APP_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================================
# Database (if applicable)
# ============================================================

DATABASE_URL=postgresql://user:password@localhost:5432/database_name
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================
# Build-specific Variables
# ============================================================

# These are typically handled by build tools
PUBLIC_URL=/
SOURCE_MAP=true

# ============================================================
# Development Server
# ============================================================

PORT=3000
BROWSER=true
FAST_REFRESH=true

# ============================================================
# Testing
# ============================================================

NODE_ENV=test
REACT_APP_TEST_API_URL=http://localhost:3001/api/test

# ============================================================
# Custom Variables
# ============================================================

# Add your project-specific variables below:

REACT_APP_CUSTOM_VAR_1=value1
REACT_APP_CUSTOM_VAR_2=value2
REACT_APP_FEATURE_FLAG_NEW_UI=false

# ============================================================
# Guidelines
# ============================================================

# DO's:
# - Use REACT_APP_ prefix for variables used in React components
# - Use descriptive names that indicate the variable's purpose
# - Include comments explaining what each variable does
# - Keep sensitive values in .env (never commit to git)
# - Use .env.example for non-sensitive defaults

# DON'Ts:
# - Don't hardcode secrets, API keys, or passwords
# - Don't commit .env file to version control
# - Don't use special characters that break shell parsing
# - Don't leave unused variables
# - Don't commit real credentials even in comments

# ============================================================
# Common Environment-Specific Values
# ============================================================

# Production:
# REACT_APP_ENVIRONMENT=production
# REACT_APP_API_URL=https://api.example.com
# REACT_APP_ENABLE_DEBUG=false
# LOG_LEVEL=error

# Staging:
# REACT_APP_ENVIRONMENT=staging
# REACT_APP_API_URL=https://staging-api.example.com
# REACT_APP_ENABLE_DEBUG=true
# LOG_LEVEL=info

# Development:
# REACT_APP_ENVIRONMENT=development
# REACT_APP_API_URL=http://localhost:3001/api
# REACT_APP_ENABLE_DEBUG=true
# LOG_LEVEL=debug

# ============================================================
# End of .env Template

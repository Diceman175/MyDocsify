# ============================================================
# Diceman175 Workspace - EditorConfig (canonical source)
# ------------------------------------------------------------
# Real file lives at:
#   governator175/symlink-target/root-files/.editorconfig
# Distributed as a real committed copy to the workspace root and to every
# repo root by governator175/symlink-target/scripts/rules/a11-formatting/sync-editorconfig.ps1
#
# Line-ending and charset policy here MUST stay in sync with:
#   - symlink-target/root-files/.gitattributes                          (commit-layer enforcement)
#   - symlink-target/standards/rules/a10-encoding/A10-WORKSPACE-ENCODING-STANDARD.md  (the governing standard)
# EditorConfig governs the editor layer; .gitattributes governs the
# commit layer. They are complementary, not duplicative.
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: preserve hard-break trailing spaces
[*.md]
trim_trailing_whitespace = false

# PowerShell: UTF-8 with BOM, CRLF (Windows convention)
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# Windows-native script and solution files: CRLF
[*.{bat,cmd,btm,vbs,reg}]
end_of_line = crlf

[*.sln]
end_of_line = crlf

# Makefiles require literal tabs
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab
trim_trailing_whitespace = false

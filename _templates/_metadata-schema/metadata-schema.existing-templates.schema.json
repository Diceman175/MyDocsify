{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_metadata": {
    "title": "Metadata Schema Existing Templates JSON Schema",
    "description": "JSON Schema for validating metadata-schema existing-templates sidecar structures",
    "author": "Steven Paradise",
    "filename": "metadata-schema.existing-templates.schema.json",
    "schema_version": "2.0.0",
    "version": "2.0.0",
    "date": "2026-05-01",
    "lastmod": "2026-05-02"
  },
  "title": "Existing Templates Sidecar Schema",
  "description": "Schema for validating template inventory sidecars",
  "type": "object",
  "required": [
    "title",
    "description",
    "author",
    "filename",
    "schema_version",
    "version",
    "date",
    "lastmod",
    "existing_templates"
  ],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "filename": { "type": "string" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastmod": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "existing_templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}

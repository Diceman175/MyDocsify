# ============================================================
# Diceman175 Workspace - Git Attributes (canonical source)
# ------------------------------------------------------------
# Real file lives at:
#   governator175/symlink-target/root-files/.gitattributes
# Distributed as a real committed copy into every repo root, and as a real
# (non-committed) copy at the workspace root, by
# governator175/symlink-target/scripts/rules/a12-git-attributes/sync-git-infrastructure.ps1
#
# Line-ending policy here MUST stay in sync with:
#   - symlink-target/root-files/.editorconfig                            (editor-layer guidance)
#   - symlink-target/standards/rules/a10-encoding/A10-WORKSPACE-ENCODING-STANDARD.md  (the governing standard)
# .gitattributes governs normalization at commit time; .editorconfig
# guides editors. Note: git cannot enforce UTF-8 BOM - BOM is enforced
# by .editorconfig charset and tools/utilities/check-encodings.ps1.
# ============================================================

# Default: treat files as text, normalize to LF on commit
* text=auto eol=lf

# POSIX / macOS Shell Scripts: strictly enforce LF across all platforms
*.sh    text eol=lf
*.bash  text eol=lf
*.zsh   text eol=lf

# Windows-native file types: keep CRLF in the working tree
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.btm   text eol=crlf
*.vbs   text eol=crlf
*.reg   text eol=crlf
*.sln   text eol=crlf

# Explicit binary - never normalize line endings, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.rar   binary
*.7z    binary
*.gz    binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.icns  binary
*.dmg   binary
*.pkg   binary

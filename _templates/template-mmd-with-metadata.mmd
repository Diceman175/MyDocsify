flowchart TD
    A([Start]) --> B{Decision Point}
    B -- Yes --> C[Process A]
    B -- No  --> D[Process B]
    C --> E{Another Decision}
    D --> E
    E -- Complete --> F([End])
    E -- Retry   --> A

    %% Style definitions
    classDef startEnd fill:#4CAF50,color:#fff,stroke:#388E3C
    classDef process  fill:#2196F3,color:#fff,stroke:#1565C0
    classDef decision fill:#FF9800,color:#fff,stroke:#E65100

    class A,F startEnd
    class C,D process
    class B,E decision

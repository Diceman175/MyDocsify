/*
 * ============================================================
 * Title: Rules for Metadata Change Governance
 * Purpose: Contains the change acronyms tracked in change_log
 *          sections in various files (.json, .jsonc, .md, .mmd, .txt, .yaml)
 * ============================================================
 */

{
  // Metadata section
  "metadata": {
    "title": "Metadata Schema Change Governance Rules",
    "description": "A JSONC formatted rule definition file for change governance codes used for change_log tracking in various files",
    "author": "Steven Paradise",
    "filename": "metadata-schema.changelog-rules.jsonc",
    "schema_version": "2.0.0",
    "version": "2.0.0",
    "date": "2026-04-09",
    "lastmod": "2026-05-02"
  },
  
  // Change log (most recent first). Each entry includes version, date, author, change code, and notes.
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-05-02",
      "author": "Steven Paradise",
      "changes": [
        {
          "code": "CHG",
          "note": "Major schema baseline upgrade to 2.0.0 for metadata governance package alignment"
        }
      ]
    },
    {
      "version": "1.3.0",
      "date": "2026-05-01",
      "author": "Steven Paradise",
      "changes": [
        {
          "code": "CHG",
          "note": "Relocated file under _templates/_metadata-schema and renamed to metadata-schema.changelog-rules.jsonc"
        }
      ]
    },
    {
      "version": "1.2.1",
      "date": "2026-04-21",
      "author": "Steven Paradise",
      "changes": [
        {
          "code": "CHG",
          "note": "Aligned metadata fields with template-jsonc-with-metadata.jsonc and restored semantic version format"
        }
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-04-20",
      "author": "Steven Paradise",
      "changes": [
        {
          "code": "REF",
          "note": "Add metadata information to the new .jsonc file"
        }
      ]
    },
    {
      "version": "1.0.0",
      "date": "2026-04-09",
      "author": "Steven Paradise",
      "changes": [
        {
          "code": "IMP",
          "note": "Implemented a new rule for change_log tracking metadata. Researched and created preference tracking with empty shell (no metadata)"
        }
      ]
    }
  ],

  // Change code definitions
  "acronyms": [
    {
      "code": "FIX",
      "meaning": "Bug fix",
      "description": "Patch addressing a bug or defect; backward-compatible fix.",
      "examples": [
        "FIX: Correct null reference in Save-Config",
        "FIX: Resolve off-by-one in index calculation"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "IMP",
      "meaning": "Implemented",
      "description": "New feature or capability added to the script or function.",
      "examples": [
        "IMP: Add support for retry logic on network calls",
        "IMP: Implement export to CSV option"
      ],
      "semantic_version_bump": "minor"
    },
    {
      "code": "CHG",
      "meaning": "Change",
      "description": "Non-breaking modification or improvement (refactor, optimization, UX tweak).",
      "examples": [
        "CHG: Refactor logging to use structured output",
        "CHG: Improve performance of data parsing loop"
      ],
      "semantic_version_bump": "minor"
    },
    {
      "code": "REF",
      "meaning": "Reference / Documentation",
      "description": "Documentation updates, comments, or references; no functional change.",
      "examples": [
        "REF: Update .SYNOPSIS and examples",
        "REF: Add inline comments for complex logic"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "BRK",
      "meaning": "Breaking",
      "description": "Change that breaks backward compatibility or alters public API/behavior.",
      "examples": [
        "BRK: Rename parameter 'Path' to 'TargetPath' (breaking)",
        "BRK: Remove deprecated function Get-OldConfig"
      ],
      "semantic_version_bump": "major"
    },
    {
      "code": "SEC",
      "meaning": "Security",
      "description": "Security-related fix, hardening, or vulnerability mitigation.",
      "examples": [
        "SEC: Sanitize input to prevent command injection",
        "SEC: Upgrade cryptographic library usage"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "TST",
      "meaning": "Test",
      "description": "Add or update tests, CI configuration, or test data.",
      "examples": [
        "TST: Add unit tests for Parse-Date function",
        "TST: Fix CI pipeline failure on Windows runners"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "DOC",
      "meaning": "Documentation",
      "description": "Larger documentation additions (README, changelog) or examples.",
      "examples": [
        "DOC: Add usage examples to README",
        "DOC: Create migration guide for v2 -> v3"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "CFG",
      "meaning": "Configuration",
      "description": "Changes to configuration, defaults, or environment setup.",
      "examples": [
        "CFG: Update default timeout to 30s",
        "CFG: Add optional env var for API endpoint"
      ],
      "semantic_version_bump": "minor"
    },
    {
      "code": "DEP",
      "meaning": "Dependency",
      "description": "Updates to dependencies or build tooling.",
      "examples": [
        "DEP: Bump PowerShellGallery module dependency to 2.1.0",
        "DEP: Update CI runner image"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "OPS",
      "meaning": "Operational",
      "description": "Operational changes like deployment, packaging, or release scripts.",
      "examples": [
        "OPS: Add release pipeline step for tagging",
        "OPS: Improve packaging to include symbols"
      ],
      "semantic_version_bump": "patch"
    },
    {
      "code": "WIP",
      "meaning": "Work in Progress",
      "description": "Incomplete work; not intended for release.",
      "examples": [
        "WIP: Prototype incremental parsing approach",
        "WIP: Experiment with new logging backend"
      ],
      "semantic_version_bump": null
    },
    {
      "code": "DEL",
      "meaning": "Deleted",
      "description": "File, feature, or capability removed; backward-incompatible deletion.",
      "examples": [
        "DEL: Remove deprecated helper script",
        "DEL: Drop support for legacy .ini config format"
      ],
      "semantic_version_bump": "minor"
    }
  ],
  "recommendations": {
    "default_for_commit_subject": "Use one acronym at start of commit/summary, followed by concise message (<= 72 chars).",
    "versioning_guidance": "Map acronyms to semantic version bumps; use BRK for major, IMP/CHG/CFG for minor, FIX/SEC/TST/DOC/DEP/OPS/REF for patch.",
    "format_examples": [
      "FIX: Correct backup path handling when network share is unavailable",
      "IMP: Add --dry-run option to Deploy-Script",
      "BRK: Remove deprecated parameter -ForceDelete (see migration guide)"
    ]
  }
}


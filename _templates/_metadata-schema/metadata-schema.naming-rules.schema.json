{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_metadata": {
    "title": "Metadata Schema Naming Rules JSON Schema",
    "description": "JSON Schema for validating metadata-schema naming-rules sidecar structures",
    "author": "Steven Paradise",
    "filename": "metadata-schema.naming-rules.schema.json",
    "schema_version": "2.0.0",
    "version": "2.0.0",
    "date": "2026-05-01",
    "lastmod": "2026-05-02"
  },
  "title": "Naming Rules Sidecar Schema",
  "description": "Schema for validating governed file family naming rules",
  "type": "object",
  "required": [
    "title",
    "description",
    "author",
    "filename",
    "schema_version",
    "version",
    "date",
    "lastmod",
    "naming_policy",
    "governed_families",
    "enforcement"
  ],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "filename": { "type": "string" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastmod": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "naming_policy": {
      "type": "object",
      "required": ["root_file_pattern", "sidecar_file_pattern", "descriptor_rules", "enforcement_rules"],
      "properties": {
        "root_file_pattern": { "type": "string" },
        "sidecar_file_pattern": { "type": "string" },
        "descriptor_rules": {
          "type": "object",
          "required": ["case", "separator", "allowed_characters", "allow_multiple_descriptor_segments"],
          "properties": {
            "case": { "type": "string" },
            "separator": { "type": "string" },
            "allowed_characters": { "type": "string" },
            "allow_multiple_descriptor_segments": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "enforcement_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "governed_families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["canonical_folder", "allowed_files"],
        "properties": {
          "canonical_folder": { "type": "string" },
          "allowed_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["validator_template_ref", "workflow_template_ref"],
      "properties": {
        "validator_template_ref": { "type": "string" },
        "workflow_template_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

# ============================================================
# Diceman175 Workspace - EditorConfig (canonical source)
# ------------------------------------------------------------
# Real file lives at:
#   governator175/standards/workspace/formatting/.editorconfig
# Symlinked to the workspace root and to every repo root.
#
# Line-ending and charset policy here MUST stay in sync with:
#   - standards/workspace/git/.gitattributes  (commit-layer enforcement)
#   - WORKSPACE-ENCODING-STANDARD.md           (the governing standard)
# EditorConfig governs the editor layer; .gitattributes governs the
# commit layer. They are complementary, not duplicative.
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PowerShell: UTF-8 with BOM, CRLF (Windows convention)
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# Windows-native script and solution files: CRLF
[*.{bat,cmd,btm,vbs,reg}]
end_of_line = crlf

[*.sln]
end_of_line = crlf

# Makefiles require literal tabs
[Makefile]
indent_style = tab

/*
 * ============================================================
 * Template: Project File with Metadata Tracking
 * Description: Demonstrates how to structure a .jsonc file with
 *          metadata, changelog, and semantic version tracking
 * ============================================================
 * 
 * Instructions:
 * 1. Copy this file and rename it to your project filename
 * 2. Update the metadata section with your project details
 * 3. Add your project data/content below the changelog
 * 4. Update changelog with each release using the change codes
 *    defined in rules-change-codes.jsonc
 * ============================================================
 */

{
  // ============================================================
  // METADATA SECTION - Required for all tracked files
  // ============================================================
  "_metadata": {
    "_note": "JSONC supports // comments. Metadata is stored as a top-level _metadata field. Reference: rules-change-codes.jsonc",
    "title": "Your Project Title",
    "description": "A brief description of what this file contains and its purpose in your project",
    "author": "Your Name",
    "filename": "your-project-file.jsonc",
    "schema_version": "2.0.0",
    "version": "0.1.0",
    "date": "2026-04-20",
    "lastmod": "2026-04-20"
  },

  // ============================================================
  // CHANGELOG SECTION - Required for version tracking
  // ============================================================
  // Most recent entries first. Reference change codes from
  // rules-change-codes.jsonc for semantic versioning
  // ============================================================
  "changelog": [
    {
      "version": "0.1.0",
      "date": "2026-04-20",
      "author": "Your Name",
      "changes": [
        {
          "code": "IMP",
          "note": "Initial project setup with metadata template"
        }
      ]
    }
  ],

  // ============================================================
  // PROJECT CONTENT SECTION - Your actual data/configuration
  // ============================================================
  // Everything below this comment is your project-specific data
  // ============================================================

  "project_config": {
    "name": "Example Project",
    "enabled": true,
    "settings": {
      "timeout": 30,
      "retries": 3,
      "debug_mode": false
    }
  },

  "data": [
    {
      "id": 1,
      "name": "Item One",
      "status": "active"
    },
    {
      "id": 2,
      "name": "Item Two",
      "status": "inactive"
    }
  ]
}

/*
 * ============================================================
 * USAGE NOTES
 * ============================================================
 * 
 * VERSION NUMBERING:
 * - MAJOR (first digit):   Breaking changes (BRK code)
 * - MINOR (second digit):  New features (IMP, CHG, CFG codes)
 * - PATCH (third digit):   Fixes and documentation (FIX, SEC, DOC, REF, TST, DEP, OPS codes)
 * 
 * CHANGELOG ENTRY TEMPLATE:
 * {
 *   "version": "X.Y.Z",
 *   "date": "YYYY-MM-DD",
 *   "author": "Name",
 *   "changes": [
 *     { "code": "XXX", "note": "Description" },
 *     { "code": "YYY", "note": "Another change" }
 *   ]
 * }
 *
 * CHANGE CODES:
 * - FIX: Bug fixes (patch bump)
 * - IMP: New features (minor bump)
 * - CHG: Improvements/refactoring (minor bump)
 * - REF: Documentation/references (patch bump)
 * - BRK: Breaking changes (major bump)
 * - SEC: Security fixes (patch bump)
 * - TST: Tests/CI (patch bump)
 * - DOC: Documentation (patch bump)
 * - CFG: Configuration (minor bump)
 * - DEP: Dependencies (patch bump)
 * - OPS: Operations/deployment (patch bump)
 * - WIP: Work in progress (no version bump)
 *
 * For full code definitions, see rules-change-codes.jsonc
 * ============================================================
 */

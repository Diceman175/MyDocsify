  "_metadata": {
    "title": "Your Node.js Project",
    "author": "Your Name",
    "filename": "package.json",
    "schema_version": "2.0.0",
    "version": "0.1.0",
    "date": "2026-04-20",
    "lastmod": "2026-04-21",
    "_note": "Remove the _metadata, _changelog, and _change_codes keys before publishing to npm."
  },
  "_changelog": [
    {
      "version": "0.1.0",
      "date": "2026-04-20",
      "author": "Your Name",
      "changes": [
        { "code": "IMP", "note": "Initial package.json setup with metadata template" }
      ]
    }
  ],
  "_change_codes": {
    "_note": "Reference: rules-change-codes.jsonc",
    "FIX": "Bug fixes (patch bump)",
    "IMP": "New features (minor bump)",
    "CHG": "Improvements/refactoring (minor bump)",
    "REF": "Documentation/references (patch bump)",
    "BRK": "Breaking changes (major bump)",
    "SEC": "Security fixes (patch bump)",
    "TST": "Tests/CI (patch bump)",
    "DOC": "Documentation (patch bump)",
    "CFG": "Configuration (minor bump)",
    "DEP": "Dependencies (patch bump)",
    "OPS": "Operations/deployment (patch bump)",
    "WIP": "Work in progress (no version bump)"
  },

  "name": "your-project-name",
  "version": "0.1.0",
  "description": "A brief description of your project",
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "private": true,

  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    }
  },

  "files": [
    "dist"
  ],

  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  },

  "scripts": {
    "build":     "tsc --project tsconfig.json",
    "dev":       "node --watch dist/index.js",
    "start":     "node dist/index.js",
    "lint":      "eslint src --ext .ts,.tsx",
    "test":      "jest",
    "test:watch":"jest --watch",
    "clean":     "rm -rf dist",
    "prepare":   "npm run build"
  },

  "dependencies": {
  },

  "devDependencies": {
    "@types/node":          "^22.0.0",
    "typescript":           "^5.0.0",
    "eslint":               "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser":        "^8.0.0",
    "jest":                 "^29.0.0",
    "@types/jest":          "^29.0.0",
    "ts-jest":              "^29.0.0"
  },

  "jest": {
    "preset":       "ts-jest",
    "testEnvironment": "node",
    "testMatch":    ["**/*.test.ts", "**/*.spec.ts"],
    "collectCoverageFrom": ["src/**/*.ts"]
  },

  "keywords": [
    "your-keyword"
  ],

  "repository": {
    "type": "git",
    "url":  "https://github.com/yourname/your-project"
  },

  "bugs": {
    "url": "https://github.com/yourname/your-project/issues"
  },

  "homepage": "https://github.com/yourname/your-project#readme"
}

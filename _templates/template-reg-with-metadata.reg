Windows Registry Editor Version 5.00

; ============================================================
; Example Registry Keys
; ============================================================

; Create or modify a key in HKEY_CURRENT_USER
[HKEY_CURRENT_USER\Software\YourCompany\YourApplication]
"Version"="0.1.0"
"Author"="Your Name"
"ConfigValue"="example_setting"
"Enabled"=dword:00000001

; Create or modify a key in HKEY_LOCAL_MACHINE (requires admin)
[HKEY_LOCAL_MACHINE\Software\YourCompany\YourApplication]
"AppName"="Your Application"
"InstallPath"="C:\\Program Files\\YourApplication"
"Version"="0.1.0"

; Delete a registry value (uncomment to use)
; [-HKEY_CURRENT_USER\Software\YourCompany\YourApplication\OldSetting]

; Delete an entire key (uncomment to use)
; [-HKEY_CURRENT_USER\Software\YourCompany\OldApplication]

; ============================================================
; Additional Examples
; ============================================================

; String value (REG_SZ)
[HKEY_CURRENT_USER\Software\YourCompany\YourApplication]
"StringValue"="This is a string"

; DWORD value (REG_DWORD)
[HKEY_CURRENT_USER\Software\YourCompany\YourApplication]
"DWordValue"=dword:000003E8

; Binary value (REG_BINARY)
[HKEY_CURRENT_USER\Software\YourCompany\YourApplication]
"BinaryValue"=hex:01,02,03,04,05

; Multi-string value (REG_MULTI_SZ)
[HKEY_CURRENT_USER\Software\YourCompany\YourApplication]
"MultiStringValue"="Line1\0Line2\0Line3\0\0"

; ============================================================
; End of Registry File
; ============================================================

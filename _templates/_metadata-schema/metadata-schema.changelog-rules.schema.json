{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_metadata": {
    "title": "Metadata Schema Change Rules JSON Schema",
    "description": "JSON Schema for validating metadata-schema change-rules data structures",
    "author": "Steven Paradise",
    "filename": "metadata-schema.changelog-rules.schema.json",
    "schema_version": "2.0.0",
    "version": "2.0.0",
    "date": "2026-05-01",
    "lastmod": "2026-05-02"
  },
  "title": "Change Governance Rules Metadata Schema",
  "description": "JSON Schema for validating change governance rule metadata structure used across .jsonc, .yaml, .md and .txt files",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "File metadata and tracking information",
      "required": ["title", "description", "author", "filename", "schema_version", "version", "date", "lastmod"],
      "properties": {
        "filename": {
          "type": "string",
          "description": "Name of the file (informational)"
        },
        "title": {
          "type": "string",
          "description": "One-line summary of the file's purpose"
        },
        "description": {
          "type": "string",
          "description": "Longer description of the file's content and purpose"
        },
        "author": {
          "type": "string",
          "description": "Author name or placeholder"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Version of the metadata standard used by the file"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (MAJOR.MINOR.PATCH)"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 creation date (YYYY-MM-DD)"
        },
        "lastmod": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 last update date (YYYY-MM-DD)"
        }
      },
      "additionalProperties": false
    },
    "changelog": {
      "type": "array",
      "description": "Change history, most recent first",
      "items": {
        "type": "object",
        "required": ["version", "date", "author", "changes"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version for this entry"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 date (YYYY-MM-DD)"
          },
          "author": {
            "type": "string",
            "description": "Author of the changes"
          },
          "changes": {
            "type": "array",
            "description": "List of changes in this version",
            "items": {
              "type": "object",
              "required": ["code", "note"],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": ["FIX", "IMP", "CHG", "REF", "BRK", "SEC", "TST", "DOC", "CFG", "DEP", "OPS", "WIP", "DEL"],
                  "description": "Change code from the metadata-schema change-governance sidecars"
                },
                "note": {
                  "type": "string",
                  "description": "Description of the change"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "metadata": {
        "filename": "example.jsonc",
        "title": "Example Configuration File",
        "description": "A sample configuration file with metadata tracking",
        "author": "Your Name",
        "version": "1.0.0",
        "date": "2026-04-20",
        "lastmod": "2026-04-20"
      },
      "changelog": [
        {
          "version": "1.0.0",
          "date": "2026-04-20",
          "author": "Your Name",
          "changes": [
            {
              "code": "IMP",
              "note": "Initial release with metadata tracking"
            }
          ]
        }
      ]
    }
  ]
}

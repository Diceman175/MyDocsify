### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/python,visualstudiocode

__pycache__/
*.py[cod]

# Governance artifacts - provided locally via symlinks (home) or
# remote-only-copy-governance-files.ps1 (restricted machines). Never committed.
/governator/
/A1-AI-AUTOMATION-PERMISSIONS.md
/A2-WORKSPACE-NAMING-STANDARD.md
/A4-A8-WORKSPACE-VERSION-STANDARD.md
/A10-WORKSPACE-ENCODING-STANDARD.md
/A3-metadata-fields.yaml
/A6-metadata-tags.yaml
# Claude Code local state - never share machine-specific config
.claude/settings.local.json
.claude/.credentials.json

# Secrets / credentials (workspace-wide failsafe)
.env
.env.local
.env.*.local
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519
*credentials*.json
secrets.yaml

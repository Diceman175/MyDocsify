# Normalize text files
* text=auto

# Force LF for source and config files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

# Force LF for Markdown and templates
*.md   text eol=lf
*.txt  text eol=lf

# Force CRLF for Windows-only file types
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.sln  text eol=crlf
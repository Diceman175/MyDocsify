<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  Title: Your Windows Script File
  Description: A brief description of what this WSF does
  ============================================================

  METADATA:
    title: Your Windows Script File
    description: A brief description of what this WSF does
    author: Your Name
    filename: YourScript.wsf
    schema_version: "2.0.0"
    version: 0.1.0
    date: 2026-04-20
    lastmod: 2026-04-20

  CHANGELOG:
    Most recent entries first. Reference change codes from
    rules-change-codes.jsonc for semantic versioning.

    Version 0.1.0 - 2026-04-20 - Your Name
      IMP: Initial WSF setup with metadata template

  CHANGE CODES:
    Reference: rules-change-codes.jsonc

    FIX  - Bug fixes (patch bump)
    IMP  - New features (minor bump)
    CHG  - Improvements/refactoring (minor bump)
    REF  - Documentation/references (patch bump)
    BRK  - Breaking changes (major bump)
    SEC  - Security fixes (patch bump)
    TST  - Tests/CI (patch bump)
    DOC  - Documentation (patch bump)
    CFG  - Configuration (minor bump)
    DEP  - Dependencies (patch bump)
    OPS  - Operations/deployment (patch bump)
    WIP  - Work in progress (no version bump)

  NOTES:
    Run with: cscript YourScript.wsf //Nologo
    WSF files support multiple languages and shared include files.
    For full code definitions, see rules-change-codes.jsonc
  ============================================================
-->
<package>
  <job id="Main">
    <runtime>
      <description>Your Windows Script File - brief description here.</description>
      <named
        name="key"
        helpstring="An example named argument"
        type="string"
        required="false"
      />
      <unnamed
        name="InputFile"
        helpstring="Optional input file path"
        many="false"
        required="false"
      />
    </runtime>

    <!-- ============================================================ -->
    <!-- VBScript block                                               -->
    <!-- ============================================================ -->
    <script language="VBScript">
    <![CDATA[

      Option Explicit

      ' ============================================================
      ' Module-level objects
      ' ============================================================
      Dim oShell, oFSO
      Set oShell = CreateObject("WScript.Shell")
      Set oFSO   = CreateObject("Scripting.FileSystemObject")

      ' ============================================================
      ' Entry point
      ' ============================================================
      Sub Main()
        On Error GoTo 0

        Dim sKey
        If WScript.Arguments.Named.Exists("key") Then
          sKey = WScript.Arguments.Named("key")
        Else
          sKey = "default-key"
        End If

        Dim result
        result = GetExampleData(sKey)

        WScript.Echo result
      End Sub

      ' ============================================================
      ' Data retrieval (VBScript)
      ' ============================================================
      Function GetExampleData(ByVal sKey)
        GetExampleData = "Data for key: " & sKey
      End Function

      ' ============================================================
      ' Run entry point
      ' ============================================================
      Call Main()

    ]]>
    </script>
  </job>

  <!-- ============================================================ -->
  <!-- Optional second job using JScript                            -->
  <!-- ============================================================ -->
  <job id="JScriptJob">
    <script language="JScript">
    <![CDATA[

      // Entry point for JScript job
      function main() {
        var shell = new ActiveXObject("WScript.Shell");
        WScript.Echo("JScript job running.");
      }

      main();

    ]]>
    </script>
  </job>
</package>
